# Optional. If set, learnings2agents uses the Gemini API for higher-quality
# per-directory synthesis (semantic dedup, cleaner bullets, thematic grouping).
# If left unset, the tool falls back to a fully offline heuristic mode.
GEMINI_API_KEY=

# Optional. Overrides the Gemini model used when GEMINI_API_KEY is set.
# When unset, the tool automatically probes gemini-3.8-flash → gemini-3.7-flash
# → gemini-3.6-flash and uses the first one that responds successfully.
GEMINI_MODEL=
